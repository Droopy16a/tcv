echnical\":[],\"category\":\"User Experience\",\"type\":\"user_experience\"},{\"_id\":\"628264455edefea35b5a877f\",\"isAxeptioVendor\":true,\"projectId\":null,\"domain\":\"https://www.hotjar.com\",\"longDescription\":\"Hotjar is a tool that allows to analyze the behavior of visitors to a website by recording the actions they do, in order to detect friction points\",\"name\":\"hotjar\",\"policyUrl\":\"https://www.hotjar.com/privacy\",\"shortDescription\":\"Recording the navigation user path\",\"title\":\"Hotjar\",\"technical\":[],\"category\":\"Session Recording, Monitoring, Analytics\",\"type\":\"session_recording, monitoring, analytics\"},{\"_id\":\"6282644588ca8e0d930c0070\",\"isAxeptioVendor\":true,\"projectId\":null,\"domain\":\"https://www.facebook.com/\",\"longDescription\":\"Allows to track the visitor's actions on the website, and see if there’s any conversions\",\"name\":\"facebook_pixel\",\"policyUrl\":\"https://en-gb.facebook.com/business/gdpr\",\"shortDescription\":\"Identifies visitors from Facebook\",\"title\":\"Facebook Pixel\",\"technical\":[],\"category\":\"Retargeting, Conversion Tracking\",\"type\":\"retargeting, conversion_tracking\"},{\"_id\":\"6282644588061728cfa750cb\",\"isAxeptioVendor\":true,\"projectId\":null,\"domain\":\"https://ads.google.com/\",\"longDescription\":\"This service allows advertisers to buy ads or banners, which will be displayed on Google stuff\",\"name\":\"google_ads\",\"policyUrl\":\"https://business.safety.google/privacy/\",\"shortDescription\":\"Measures the performance of Google campaigns\",\"title\":\"Google Advertising Products\",\"technical\":[],\"category\":\"Advertising, Analytics\",\"type\":\"advertising, analytics\"},{\"_id\":\"628264451d18a17fffab92c1\",\"isAxeptioVendor\":true,\"projectId\":null,\"domain\":\"https://www.bing.com/\",\"longDescription\":\"Search engine / Browser\",\"name\":\"bing\",\"policyUrl\":\"https://privacy.microsoft.com/en-gb/privacystatement\",\"shortDescription\":\"Advertising network\