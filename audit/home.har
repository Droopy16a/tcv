yption","value":"AES256"},{"name":"x-amz-version-id","value":"lQRPmYzJsZ1CfiY78VeTr0Bwg2f0yC6x"},{"name":"x-cache","value":"Hit from cloudfront"}],"content":{"size":-1,"mimeType":"application/json; charset=utf-8","text":"{\"id\":1937819,\"name\":\"Variation 1\",\"modifications\":[{\"id\":6137768,\"selector\":\"\",\"type\":\"addCSS\",\"value\":\"/* ============================================================================\\r\\n   BOUTON CARTE CADEAU MOURATOGLOU\\r\\n   Desktop (icône uniquement) + Mobile (icône + texte)\\r\\n   ============================================================================ */\\r\\n\\r\\n/* ========================================\\r\\n   RESET DE BASE\\r\\n   ======================================== */\\r\\n.header-gift-desktop,\\r\\n.header-gift-mobile-btn {\\r\\n    margin: 0;\\r\\n    padding: 0;\\r\\n}\\r\\n\\r\\n/* ========================================\\r\\n   VERSION DESKTOP UNIQUEMENT (>= 1024px)\\r\\n   Affiche uniquement l'icône cadeau\\r\\n   ======================================== */\\r\\n.header-gift-desktop {\\r\\n    display: none;\\r\\n}\\r\\n\\r\\n@media (min-width: 1024px) {\\r\\n    /* Conteneur du bouton desktop */\\r\\n    .header-gift-desktop {\\r\\n        display: flex;\\r\\n        align-items: center;\\r\\n        list-style: none;\\r\\n    }\\r\\n    \\r\\n    /* Lien/bouton desktop */\\r\\n    .header-gift-link {\\r\\n        display: inline-flex;\\r\\n        align-items: center;\\r\\n        justify-content: center;\\r\\n        background-color: #ffffff;\\r\\n        height: 60px;\\r\\n        min-width: 60px;\\r\\n        padding: 0 16px;\\r\\n        border-radius: 0;\\r\\n        text-decoration: none;\\r\\n        transition: all 0.2s ease;\\r\\n        border: none;\\r\\n        outline: none;\\r\\n    }\\r\\n    \\r\\n    /* États hover et focus du bouton desktop */\\r\\n    .header-gift-link:hover {\\r\\n        opacity: 0.9;\\r\\n        background-color: #f5f5f5;\\r\\n    }\\r\\n    \\r\\n    .header-gift-link:focus {\\r\\n        outline: 2px solid #000;\\r\\n        outline-offset: 2px;\\r\\n    }\\r\\n    \\r\\n    .header-gift-link:active {\\r\\n        transform: scale(0.98);\\r\\n    }\\r\\n    \\r\\n    /* Icône du bouton desktop */\\r\\n    .header-gift-icon {\\r\\n        width: 28px;\\r\\n        height: 28px;\\r\\n        display: block;\\r\\n        pointer-events: none;\\r\\n    }\\r\\n}\\r\\n\\r\\n/* ========================================\\r\\n   VERSION MOBILE UNIQUEMENT (< 1024px)\\r\\n   Affiche icône + texte \\\"Carte cadeau\\\"\\r\\n   ======================================== */\\r\\n@media (max-width: 1023px) {\\r\\n    /* Forcer le masquage du bouton desktop sur mobile */\\r\\n    .header-gift-desktop {\\r\\n        display: none !important;\\r\\n    }\\r\\n    \\r\\n    /* Bouton mobile - même style que .button.button--fill */\\r\\n    .header-gift-mobile-btn {\\r\\n        /* Layout */\\r\\n        display: flex !important;\\r\\n        align-items: center;\\r\\n        justify-content: center;\\r\\n        gap: 8px;\\r\\n        width: 100%;\\r\\n        min-height: 48px;\\r\\n        padding: 12px 24px;\\r\\n        \\r\\n        /* Couleurs */\\r\\n        background-color: #ffffff;\\r\\n        color: #000000;\\r\\n        \\r\\n        /* Typographie */\\r\\n        font-family: inherit;\\r\\n        font-size: 14px;\\r\\n        font-weight: 600;\\r\\n        line-height: 1.2;\\r\\n        letter-spacing: 0.5px;\\r\\n        text-align: center;\\r\\n        text-decoration: none;\\r\\n        text-transform: uppercase;\\r\\n        \\r\\n        /* Bordures et coins */\\r\\n        border: 1px solid #e0e0e0;\\r\\n        border-radius: 4px;\\r\\n        \\r\\n        /* Interactions */\\r\\n        cursor: pointer;\\r\\n        transition: all 0.2s ease;\\r\\n        -webkit-tap-highlight-color: transparent;\\r\\n    }\\r\\n    \\r\\n    /* États hover et focus du bouton mobile */\\r\\n    .header-gift-mobile-btn:hover,\\r\\n    .header-gift-mobile-btn:focus {\\r\\n        background-color: #f5f5f5;\\r\\n        border-color: #d0d0d0;\\r\\n    }\\r\\n    \\r\\n    .header-gift-mobile-btn:active {\\r\\n        transform: scale(0.98);\\r\\n        background-color: #ebebeb;\\r\\n    }\\r\\n    \\r\\n    /* Icône dans le bouton mobile */\\r\\n    .header-gift-mobile-btn .header-gift-icon {\\r\\n        width: 28px;\\r\\n        height: 28px;\\r\\n        display: block !important;\\r\\n        flex-shrink: 0;\\r\\n        margin: 0;\\r\\n    }\\r\\n    \\r\\n    /* Texte du bouton mobile */\\r\\n    .header-gift-mobile-btn .button-label {\\r\\n        display: block;\\r\\n    }\\r\\n    \\r\\n    /* Organisation du menu footer en colonne */\\r\\n    .menu-footer {\\r\\n        display: flex;\\r\\n        flex-direction: column;\\r\\n        gap: 12px;\\r\\n        width: 100%;\\r\\n    }\\r\\n}\\r\\n\\r\\n/* ========================================\\r\\n   MEDIA QUERIES INTERMÉDIAIRES (TABLET)\\r\\n   ======================================== */\\r\\n@media (min-width: 768px) and (max-width: 1023px) {\\r\\n    /* Ajustements spécifiques pour tablettes si nécessaire */\\r\\n    .header-gift-mobile-btn {\\r\\n        max-width: 400px;\\r\\n        margin: 0 auto;\\r\\n    }\\r\\n}\\r\\n\\r\\n/* ========================================\\r\\n   ACCESSIBILITÉ\\r\\n   ======================================== */\\r\\n/* Focus visible pour la navigation au clavier */\\r\\n.header-gift-link:focus-visible,\\r\\n.header-gift-mobile-btn:focus-visible {\\r\\n    outline: 2px solid #000000;\\r\\n    outline-offset: 2px;\\r\\n}\\r\\n\\r\\n/* Préférence de mouvement réduit */\\r\\n@media (prefers-reduced-motion: reduce) {\\r\\n    .header-gift-link,\\r\\n    .header-gift-mobile-btn {\\r\\n        transition: none;\\r\\n    }\\r\\n}\\r\\n\\r\\n/* Mode sombre (optionnel) */\\r\\n@media (prefers-color-scheme: dark) {\\r\\n    .header-gift-link:hover {\\r\\n        background-color: #e0e0e0;\\r\\n    }\\r\\n    \\r\\n    .header-gift-mobile-btn {\\r\\n        background-color: #ffffff;\\r\\n        color: #000000;\\r\\n    }\\r\\n}\"},{\"id\":6137769,\"selector\":\"\",\"type\":\"customScriptNew\"}],\"_tagInfo\":\"2026/05/27 11:49:27 UTC\"}"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":1.393}},{"startedDateTime":"2026-06-01T15:32:49.408Z","time":1.548,"request":{"method":"GET","url":"https://try.abtasty.com/873fcc38d401fba393b290bad4e29eb4/1636147.2042453.json?bd433d46c51224480e347c122328df33","httpVersion":"h3","cookies":[],"headers":[{"name":":authority","value":"try.abtasty.com"},{"name":":method","value":"GET"},{"name":":path","value":"/873fcc38d401fba393b290bad4e29eb4/1636147.2042453.json?bd433d46c51224480e347c122328df33"},{"name":":scheme","value":"https"},{"name":"accept","value":"*/*"},{"name":"accept-encoding","value":"gzip, deflate, br, zstd"},{"name":"accept-language","value":"fr-FR,fr;q=0.9"},{"name":"origin","value":"https://www.mouratoglou.com"},{"name":"priority","value":"u=1, i"},{"name":"referer","value":"https://www.mouratoglou.com/"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"148\", \"Google Chrome\";v=\"148\", \"Not/A)Brand\";v=\"99\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Windows\""},{"name":"sec-fetch-dest","value":"empty"},{"name":"sec-fetch-mode","value":"cors"},{"name":"sec-fetch-site","value":"cross-site"},{"name":"user-agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/148.0.0.0 Safari/537.36"}],"queryString":[{"name":"bd433d46c51224480e347c122328df33","value":""}],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"","httpVersion":"h3","cookies":[],"headers":[{"name":"access-control-allow-methods","value":"GET, HEAD"},{"name":"access-control-allow-origin","value":"*"},{"name":"access-control-expose-headers","value":"access-control-allow-origin"},{"name":"access